#!/usr/bin/env bash
# Builds the hoglint-facts binary and the hoglint_native Python extension (the native engine)
# with the toolchain pinned in rust-toolchain.toml. A cargo from flox or Homebrew is often
# older than the ruff crates allow, so this script always asks rustup for the pinned cargo.
# maturin (from PATH, else through uvx) then builds the hoglint wheel of pyproject.toml, with
# the binary staged by bin/stage-facts, into $CARGO_TARGET_DIR/wheels. The extension is unpacked
# from it into $CARGO_TARGET_DIR/python, where hoglint.native.bridge finds it. Prints the binary
# path on success.
#
# Usage: bin/build [extra cargo args]
# Env:   CARGO_TARGET_DIR (default: ~/.cache/hoglint-target)

set -euo pipefail

crate_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$crate_dir"

if ! command -v rustup >/dev/null 2>&1; then
    echo "rustup not found. Install it from https://rustup.rs, then re-run this script." >&2
    exit 1
fi

toolchain="$(sed -n 's/^channel *= *"\(.*\)"/\1/p' rust-toolchain.toml)"
if ! rustup which cargo >/dev/null 2>&1; then
    rustup toolchain install "$toolchain" --profile minimal
fi
cargo_bin="$(rustup which cargo)"

export CARGO_TARGET_DIR="${CARGO_TARGET_DIR:-$HOME/.cache/hoglint-target}"
export PATH="$(dirname "$cargo_bin"):$PATH"

"$cargo_bin" build --release --locked "$@" >&2
binary="$CARGO_TARGET_DIR/release/hoglint-facts"
echo "built native id $("$binary" --native-id) with rust $toolchain" >&2
# The wheel build needs the binary in its data directory; the cargo build above made it already.
bin/stage-facts >&2

maturin_version="1.16.0"
if command -v maturin >/dev/null 2>&1; then
    maturin_cmd=(maturin)
elif command -v uvx >/dev/null 2>&1; then
    maturin_cmd=(uvx --from "maturin==$maturin_version" maturin)
else
    echo "maturin not found and no uvx to run it. Install uv or maturin, then re-run this script." >&2
    exit 1
fi
wheels="$CARGO_TARGET_DIR/wheels"
rm -f "$wheels"/hoglint-*.whl
# A local wheel is never shipped, so it skips the manylinux audit, which fails on a glibc above
# 2.17. Release wheels keep `manylinux2014` (pyproject.toml) and are built in a manylinux
# container (.github/workflows/wheels.yml).
"${maturin_cmd[@]}" build --release --locked --compatibility linux --out "$wheels" "$@" >&2
module_dir="$CARGO_TARGET_DIR/python"
rm -rf "$module_dir/hoglint_native"
mkdir -p "$module_dir"
unzip -q -o "$wheels"/hoglint-*.whl 'hoglint_native/*' -d "$module_dir"
echo "built hoglint_native into $module_dir" >&2
echo "$binary"
