#!/usr/bin/env bash
# Checks the model repository (tests/model_repo) in the native engine and prints which cases
# changed verdict against its reviewed expected file. Run it after a rule or preset change.
#
# Usage: bin/model-repo [--refresh] [--keep]
# Env:   HOGLINT_PYTHON (default: the repo's .venv), and the usual HOGLINT_NATIVE_DIR and
#        HOGLINT_FACTS_BIN for a native module and extractor built elsewhere.

set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
python="${HOGLINT_PYTHON:-$root/.venv/bin/python}"
cd "$root"
PYTHONPATH="$root:$root/tests" exec "$python" -m model_repo.check "$@"
