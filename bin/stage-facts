#!/usr/bin/env bash
# Builds the hoglint-facts binary for the hoglint wheel and puts it in the wheel's data directory
# (`data` in pyproject.toml), from where the wheel installs it as hoglint/bin/hoglint-facts, next
# to the package that runs it. Run it right before `maturin build`, with the target that build
# gets, as bin/build and the release workflow do. Without it, `maturin build` stops.
#
# Usage: bin/stage-facts [target triple]
# Env:   CARGO_TARGET_DIR (default: target)

set -euo pipefail

crate_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$crate_dir"

target_dir="${CARGO_TARGET_DIR:-$crate_dir/target}"
args=(build --release --locked --bin hoglint-facts)
built="$target_dir/release/hoglint-facts"
if [ $# -gt 0 ]; then
    # The toolchain rust-toolchain.toml pins may lack the target; adding it again is a no-op.
    if command -v rustup >/dev/null 2>&1; then
        rustup target add "$1" >&2
    fi
    args+=(--target "$1")
    built="$target_dir/$1/release/hoglint-facts"
fi
cargo "${args[@]}" >&2

staged="wheel-data/platlib/hoglint/bin"
rm -rf wheel-data
mkdir -p "$staged"
cp "$built" "$staged/hoglint-facts"
echo "$crate_dir/$staged/hoglint-facts"
