#!/usr/bin/env bash
# Runs the mechanical checks of a change side by side and prints one verdict table, with a log
# file per check. Exit 0 only when every check passed. See `bin/prove --help` for the real-size
# options (snapshots, a base rev, the replay sample).
#
# Usage: bin/prove [options]
# Env:   HOGLINT_PYTHON (default: the repo's .venv), the Python that runs the checks and the suite.

set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
python="${HOGLINT_PYTHON:-$root/.venv/bin/python}"
cd "$root"
PYTHONPATH="$root:$root/tests" exec "$python" -m prove.command "$@"
